###############################################################################
# Customer Support Call Transcription & Incident Form System
# Copy this file to .env and fill in real values before running.
###############################################################################

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=support
POSTGRES_PASSWORD=support_secret
POSTGRES_DB=support_db

POSTGRES_N8N_USER=n8n_user
POSTGRES_N8N_PASSWORD=n8n
POSTGRES_N8N_DB=n8n_db

ADMIN_EMAIL=admin@example.com
ADMINPASSWORD=admin123

# ── n8n Orchestrator ────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=admin
TZ=Europe/Amsterdam

# ── Email Sender (SMTP) ────────────────────────────────────────────────────
# LOCAL DEV: Use Mailpit (catches all emails, no real delivery)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@example.com
SMTP_USE_TLS=false

# PRODUCTION: Uncomment below and comment out the Mailpit block above.
# For Outlook, you need a Microsoft App Password (not your regular password).
#SMTP_HOST=smtp-mail.outlook.com
#SMTP_PORT=587
#SMTP_USER=your-email@hotmail.com
#SMTP_PASSWORD=YOUR_APP_PASSWORD_HERE
#SMTP_FROM=your-email@hotmail.com
#SMTP_USE_TLS=true

# ── Support Team Notification ──────────────────────────────────────────────
# Email address where completed incident forms are sent.
SUPPORT_EMAIL=support-team@example.com

# ── Email Monitor (Outlook Inbox Monitoring) ───────────────────────────────
# Monitor an Outlook inbox for incoming emails and classify them as service-related.
# NOTE: Ensure your Entra app has the "Mail.Read" permission (covers attachments).
CLIENT_ID = xxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TENANT_ID = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Attachment retrieval and processing
ATTACHMENTS_STORAGE=/storage/uploads
MAX_ATTACHMENT_SIZE_MB=50
# ── Ollama (local LLM for AI form-filling) ────────────────────────────────
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://ollama:11434
OLLAMA_CONNECT_TIMEOUT=3
OLLAMA_READ_TIMEOUT=180
OLLAMA_TRANSLATE_READ_TIMEOUT=180
OLLAMA_PULL_TIMEOUT=900
TRANSLATION_CHUNK_MAX_CHARS=2500
DEFAULT_INCLUDE_DUTCH_TRANSLATION=true
OLLAMA_GPUS=all
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=-1

# Transcript formatter content filter mode:
# - basic: built-in blocked words
# - custom: only use TERM_FILTER_CUSTOM_WORDS
# - off: disable filtering
TERM_FILTER_MODE=basic
TERM_FILTER_CUSTOM_WORDS=
TERM_FILTER_REPLACEMENT=[redacted]
FORMATTER_URL=http://transcript-formatter:5001/format
FORMATTER_TIMEOUT_SECONDS=360
EMAIL_URL=http://email-sender:5002/send
DB_HOST=database
DB_PORT=5432
DB_SAVE_WAIT_SECONDS=8

# ── Transcriber (Whisper model size) ──────────────────────────────────────
# Options: tiny, base, small, medium, large-v2, large-v3
# Larger models are more accurate but use more RAM and are slower.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
NUM_SPEAKERS=2

# ── Telephony Ingest (PBX/provider webhook adapter) ───────────────────────
# Shared token expected on inbound webhook header: X-Telephony-Token
TELEPHONY_WEBHOOK_TOKEN=

# Where telephony-ingest forwards recordings into the existing pipeline.
VOICE_APP_UPLOAD_URL=http://voice-app:5000/upload
# TRANSCRIBER_URL is set above in the Transcriber section

# Optional auth for provider recording download URLs.
# Example: RECORDING_AUTH_HEADER=Authorization
#          RECORDING_AUTH_VALUE=Bearer <token>
RECORDING_AUTH_HEADER=
RECORDING_AUTH_VALUE=

RECORDING_DOWNLOAD_TIMEOUT=120
VOICE_APP_FORWARD_TIMEOUT=900

# ── WhatsApp Ingest (Twilio WhatsApp sandbox / business sender) ───────────
# Find SID + auth token in the Twilio Console. For the sandbox, FROM is the
# shared number "whatsapp:+14155238886"; for production use your approved
# WhatsApp sender, e.g. "whatsapp:+31201234567".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to "false" only for local curl tests — leave true in any environment
# that's reachable by Twilio so requests are signature-verified.
TWILIO_VALIDATE_SIGNATURE=true

# Public URL of whatsapp-ingest as Twilio sees it (e.g. https://abc123.ngrok.app).
# Required when behind ngrok / a reverse proxy so signature validation works;
# leave empty when Twilio hits the service directly.
WHATSAPP_PUBLIC_BASE_URL=

# Auto-reply text. Set WHATSAPP_SILENT_REPLY=true to suppress auto-acks.
WHATSAPP_AUTO_ACK_TEXT=Got it — processing your message.
WHATSAPP_AUTO_ACK_VOICE=Got your voice note — transcribing now.
WHATSAPP_SILENT_REPLY=false

MEDIA_DOWNLOAD_TIMEOUT=120

# ── FreePBX Docker Lab (optional local telephony stack) ───────────────────
PBX_DB_ROOT_PASSWORD=pbx_root_change_me
PBX_DB_NAME=asterisk
PBX_DB_USER=asterisk
PBX_DB_PASSWORD=asterisk_change_me
PBX_HTTP_PORT=8088
PBX_HTTPS_PORT=8443
PBX_SIP_PORT=5060
PBX_PJSIP_PORT=5160
PBX_RTP_START=10000
PBX_RTP_FINISH=10050

# ── AMI Listener (CDR event watcher → webhook sender) ────────────────────
AMI_HOST=freepbx
AMI_PORT=5038
AMI_USER=admin-docker
AMI_PASS=change_me_ami_secret
WEBHOOK_URL=http://telephony-ingest:5010/webhooks/recording-complete
WEBHOOK_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────────
# Dashboard (./dashboard)
# Service `dashboard` in docker-compose.yml. Inside the container,
# DATABASE_URL is overridden to the in-network DSN automatically.
# ─────────────────────────────────────────────────────────────────────────
# Voice-app upload endpoint and Mailpit URL the dashboard uses inside docker-compose.
# Override only if you've changed the service hostnames or ports.
VOICE_APP_UPLOAD_URL_DASHBOARD=http://voice-app:5000/upload
MAILPIT_URL_DASHBOARD=http://mailpit:8025
OLLAMA_URL_DASHBOARD=http://ollama:11434

# Optional: Outlook (Microsoft Graph) inbox source. Leave empty to disable
# the Outlook tab. Uses client-credentials flow against a shared mailbox —
# register an Azure AD app with `Mail.Read` (and optionally `Mail.ReadWrite`)
# as APPLICATION permissions, then admin-consent.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=
# Folder name (well-known like "Inbox", "SentItems", "Drafts") or folder ID.
OUTLOOK_FOLDER=Inbox

# ── Email monitor / Outlook ingest (ISR-241+) ───────────────────────────────
VOICE_APP_URL=http://voice-app:5000
PROCESSED_EMAILS_STORE=/storage/processed_message_ids.json
SUPPORT_INBOX_ADDRESSES=
GRAPH_MAILBOX=

# Auth mode: imap | personal | device | application (see docs/EMAIL_INGEST_SETUP.md)
GRAPH_AUTH_MODE=imap
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=

# Outlook Graph personal (@outlook.com): GRAPH_AUTH_MODE=personal + device login
# Azure tenant: GRAPH_AUTH_MODE=device + GRAPH_TENANT_ID + device login
# Gmail: GRAPH_AUTH_MODE=imap + OUTLOOK_IMAP_HOST=imap.gmail.com + app password
OUTLOOK_IMAP_HOST=outlook.office365.com
OUTLOOK_IMAP_PORT=993
OUTLOOK_IMAP_USER=
OUTLOOK_IMAP_PASSWORD=
EMAIL_ENABLE_BACKGROUND_SYNC=true

# ── Email classifier in voice-app pipeline (ISR-311) ────────────────────────
CLASSIFIER_UNCLEAR_THRESHOLD=0.55
