# Postgres from the existing docker-compose database container.
# `docker compose up -d database` exposes 5432 on the host.
DATABASE_URL="postgresql://support:support_secret@localhost:5432/support_db"

# Voice-app endpoint that runs the AI pipeline (transcribe → form fill → email).
# Inside docker-compose:        http://voice-app:5000/upload
# Host development:             http://localhost:5000/upload
VOICE_APP_UPLOAD_URL="http://localhost:5000/upload"

# Mailpit base URL — used by the dashboard's /inbox view to proxy SMTP messages.
# Inside docker-compose:        http://mailpit:8025
# Host development:             http://localhost:8025
MAILPIT_URL="http://localhost:8025"

# Ollama base URL — used by /search to embed queries.
# Inside docker-compose:        http://ollama:11434
# Host development:             http://localhost:11434
OLLAMA_URL="http://localhost:11434"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Optional: Outlook (Microsoft Graph) inbox source. Leave empty to disable
# the Outlook tab. Uses client-credentials flow with `Mail.Read` application
# permission against a shared mailbox.
OUTLOOK_TENANT_ID=""
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_MAILBOX=""
OUTLOOK_FOLDER="Inbox"
OUTLOOK_WEB_SECRET="outlook-secret"
