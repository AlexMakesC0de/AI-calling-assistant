# ── Database ────────────────────────────────────────────────────────────────
# docker-compose:  postgresql://support:support_secret@database:5432/support_db
# Host dev:        postgresql://support:support_secret@localhost:5432/support_db
DATABASE_URL="postgresql://support:support_secret@localhost:5432/support_db"

# ── Auth ────────────────────────────────────────────────────────────────────
# JWT signing secret. Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Token encryption (AES-256-GCM). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# ── Twilio (voice webhooks + WhatsApp media download) ──────────────────────
# Required for /webhook/* routes and WhatsApp media proxy.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# ── Voice call webhooks (/webhook/voice, /webhook/recording-status) ────────
# Public URL that Twilio POSTs to. Railway URL in prod, ngrok in dev.
PUBLIC_WEBHOOK_BASE_URL="http://localhost:3000"
# Greeting played to the caller before recording starts.
CALL_GREETING_TEXT="Thank you for calling support. Please describe your issue after the tone."
# Maximum recording length in seconds.
CALL_MAX_RECORDING_SECONDS=300

# ── Pipeline services (defaults target local docker-compose ports) ─────────
# Voice-app endpoint that runs the AI pipeline (transcribe -> form fill -> email).
# docker-compose:  http://voice-app:5000/upload
# Host dev:        http://localhost:5000/upload
VOICE_APP_UPLOAD_URL="http://localhost:5000/upload"

# Mailpit base URL — used by the dashboard's /inbox view.
# docker-compose:  http://mailpit:8025
# Host dev:        http://localhost:8025
MAILPIT_URL="http://localhost:8025"

# Ollama base URL — used for embedding queries in /search.
# docker-compose:  http://ollama:11434
# Host dev:        http://localhost:11434
OLLAMA_URL="http://localhost:11434"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Transcript formatter (incident form generation).
# docker-compose:  http://transcript-formatter:5001
# Host dev:        http://localhost:5001
FORMATTER_URL="http://localhost:5001"

# ── Media / recording directories ──────────────────────────────────────────
# docker-compose maps these to /data/shared/* automatically.
# Override for host-mode dev with local absolute paths.
# CALL_RECORDINGS_DIR="/data/shared/call-recordings"
# WHATSAPP_MEDIA_DIR="/data/shared/whatsapp-media"
# EMAIL_ATTACHMENTS_DIR="/data/shared/email-attachments"
# OUTLOOK_ATTACHMENTS_DIR="/data/shared/outlook-attachments"

# ── Outlook (Microsoft Graph) — optional inbox source ─────────────────────
# Uses client-credentials flow with Mail.Read application permission.
# Leave empty to disable the Outlook tab.
OUTLOOK_TENANT_ID=""
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_MAILBOX=""
OUTLOOK_FOLDER="Inbox"

# ── Google (Gmail OAuth) — optional inbox source ──────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
